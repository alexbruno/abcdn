{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "abcdn",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-14",
  "assets": {
    "directory": "public",
  },
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "abcdn",
    },
  ],
  "triggers": {
    "crons": [
      "*/10 * * * *",
      "0 4 * * mon"
    ],
  },
  "queues": {
    "producers": [
      {
        "queue": "abcdn",
        "binding": "QUEUE",
      },
    ],
    "consumers": [
      {
        "queue": "abcdn",
      },
    ],
  },
  "env": {
    "dev": {
      "triggers": {
        "crons": [
          "* * * * *"
        ],
      },
    },
  },
  // "compatibility_flags": [
